# Trivium reads these from the environment. Everything is optional.
# Load them with your process manager, or: set -a; source .env; set +a; npm start

# PORT=3001
# HOST=0.0.0.0
# TRIVIUM_DB=data/trivium.db

# PIN for the host console. Without one, /host only works on the machine running the server.
# HOST_PIN=4827

# Public address for QR codes when you run behind a tunnel or reverse proxy.
# PUBLIC_URL=https://trivia.example.com

# Make players enter the four-letter code shown on the big screen.
# REQUIRE_JOIN_CODE=1
